{
  "manifest_version": 3,
  "name": "Quiet Launcher",
  "version": "0.1.0",
  "description": "Your streaming services in one place, full screen, in the quiet launcher's look.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "favicon"
  ],
  "commands": {
    "go-home": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "chromeos": "Alt+Shift+H"
      },
      "description": "Back to the launcher"
    },
    "go-last": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "chromeos": "Alt+Shift+J"
      },
      "description": "Back to the last service"
    }
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
